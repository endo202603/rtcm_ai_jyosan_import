# 社内生成AIのWeb画面
GENAI_WEB_URL=https://genu.n-coke.com/use-case-builder/execute/7ef1d4ea-837d-4870-baf4-28e7cd35bba9
GENAI_CREDENTIAL_TARGET=genu.n-coke.com
# Edgeのログイン状態を保持するフォルダ
GENAI_BROWSER_PROFILE=C:\RTCM_AI\browser-profile
GENAI_UPLOAD_TIMEOUT_SECONDS=180
GENAI_RESULT_TIMEOUT_SECONDS=300

# RTCM登録成功後のC1需要家倉庫登録
C1_WAREHOUSE_ENABLED=true
C1_LOGIN_URL=http://192.168.9.98/c1web/initialize.ini
C1_WAREHOUSE_URL=http://192.168.9.98/c1web/ax040010/uiax040010.render?QuiqIdentity=1791265309754x648290619
C1_CREDENTIAL_TARGET=C1_Auto_Fill: 192.168.9.98
C1_BROWSER_PROFILE=C:\RTCM_AI\c1-browser-profile
C1_TIMEOUT_SECONDS=180
# 既存登録 EG745 の次から空きコードを照会して採番
C1_WAREHOUSE_CODE_PREFIX=EG
C1_WAREHOUSE_CODE_START=746
# 添付された登録済倉庫と同じ所在地組織
C1_WAREHOUSE_LOCATION_ORG=361000

# 監視・作業フォルダ
RTCM_WATCH_FOLDER=C:\RTCM_AI\inbox
RTCM_WORK_FOLDER=C:\RTCM_AI\work
RTCM_POLL_SECONDS=3
RTCM_FILE_STABLE_SECONDS=5
# 月曜～金曜の一括処理時刻（HH:MM）
RTCM_BATCH_TIME=08:15
RTCM_AUTO_RETRY_ERRORS=false
RTCM_ERROR_RETRY_SECONDS=300
# RTCM更新成功後にPDFを監視フォルダ配下のYYYYフォルダへ移動するか
RTCM_ARCHIVE_PDF_ENABLED=false
# メール通知設定。ファイルが存在しない場合、通知は無効です。
RTCM_NOTIFY_CONFIG=C:\RTCM_AI\notify.json

# XDW変換
DOCUWORKS_VIEWER=C:\Program Files (x86)\FUJIFILM\DocuWorks\bin\dwviewer.exe
DOCUWORKS_PDF_PRINTER=DocuWorks PDF
DOCUWORKS_PDF_OUTPUT_FOLDER=C:\DocuWorksPdfOut
XDW_CONVERT_TIMEOUT_SECONDS=180

# API接続を使う単発実行用（ブラウザ監視では使用しません）
GENAI_ENDPOINT=https://internal-ai.example.local/v1/responses
GENAI_API_STYLE=responses
GENAI_MODEL=your-vision-model
GENAI_API_KEY=
GENAI_AUTH_HEADER=Authorization
GENAI_AUTH_PREFIX=Bearer

# Oracle接続
ORACLE_USER=rtcm_user
ORACLE_PASSWORD=change-me
ORACLE_DSN=dbhost.example.local:1521/RTCM

# RTCMの対象組織・監査情報
RTCM_KAICD=MMC
RTCM_KYOTENCD=MMC
RTCM_KOJCD=MMC
RTCM_USER_ID=80209
# 新規プログラム専用PGIDを推奨（AK01200Gにすると画面更新と区別できません）
RTCM_PGID=AIJYSN01
